// tools.xenastudios.co: TanStack Start on a Cloudflare Worker. Every page is
// prerendered and served as a static asset (free, and the Worker doesn't run);
// the Worker handles only the tools that need a server. Headers, the CSP among
// them, are in public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xenastudios-tools",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  // /gradient serves gradient/index.html directly, matching the canonical URLs.
  "assets": { "html_handling": "drop-trailing-slash", "not_found_handling": "none" },
  // Only the custom domain (tools.xenastudios.co, attached once by hand): no
  // workers.dev or preview addresses, and the deploy token never needs DNS access.
  "workers_dev": false,
  "preview_urls": false
}
